# Copy to .env and adjust. Values below are the defaults.

# Application (nexfix.bootstrap.config.settings.AppSettings)
APP_SERVICE_NAME=NexFix
APP_SERVICE_VERSION=1.0.0
APP_DEBUG_MODE=false

# Logging (nexfix.bootstrap.config.settings.LoggingSettings)
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO
# LOGGING_FMT="[%(asctime)s.%(msecs)03d] [%(threadName)s] %(funcName)20s %(module)s:%(lineno)d %(levelname)-8s - %(message)s"
# LOGGING_DATEFMT="%Y-%m-%d %H:%M:%S"

# Granian server (docker-entrypoint.py -> granian)
GRANIAN_HOST=0.0.0.0
GRANIAN_PORT=8000
GRANIAN_WORKERS=1
GRANIAN_LOOP=uvloop
